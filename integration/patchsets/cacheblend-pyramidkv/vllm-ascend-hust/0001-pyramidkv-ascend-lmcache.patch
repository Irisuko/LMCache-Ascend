+        key=key[128:],
+        value=value[128:],
+        kv_cache=cache,
+        attn_metadata=prefill_metadata,
+    )
+    write_cache(
+        SimpleNamespace(layer_name=layer_name),
+        key[128:],
+        value[128:],
+        cache,
+        prefill_metadata.slot_mapping,
