+def test_chunked_prefill_rejects_duplicate_gap_and_nonmonotonic_blocks() -> None:
+    provider = PyramidKVAscendProvider(_config())
+    first = provider.build_attention_batch_view(
+        request_ids=("request",),
+        query_lengths=(256,),
