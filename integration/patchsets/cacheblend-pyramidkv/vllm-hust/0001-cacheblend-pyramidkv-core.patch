+    def get_compression_cache_hit_limit(self, request: Request) -> int | None:
+        """Return the aligned total cache-hit limit for compression prefill."""
+        runtime_spec = self.kv_cache_compression_runtime_spec
+        if runtime_spec is None or not self.request_requires_compression(request):
+            return None
+        max_cached_tokens = max(
+            0,
+            request.num_prompt_tokens - runtime_spec.required_recompute_tokens,
+        )
+        block_size = self._kv_cache_compression_block_size
+        return max_cached_tokens // block_size * block_size
+
+    def limit_compression_external_cache_hits(
+        self,
+        request: Request,
+        num_local_cached_tokens: int,
+        num_external_cached_tokens: int,
+    ) -> int:
+        """Cap connector hits so local and external hits share one limit."""
+        cache_hit_limit = self.get_compression_cache_hit_limit(request)
+        if cache_hit_limit is None:
+            return num_external_cached_tokens
+        if num_local_cached_tokens > cache_hit_limit:
+            raise KVCacheCompressionError(
+                "local cache hits exceed the compression recompute limit: "
+                f"request={request.request_id!r}, local={num_local_cached_tokens}, "
+                f"limit={cache_hit_limit}"
+            )
+        capped_external_tokens = min(
+            num_external_cached_tokens,
+            cache_hit_limit - num_local_cached_tokens,
+        )
+        block_size = self._kv_cache_compression_block_size
+        total_cached_tokens = num_local_cached_tokens + capped_external_tokens
+        aligned_total_cached_tokens = total_cached_tokens // block_size * block_size
+        return aligned_total_cached_tokens - num_local_cached_tokens
+
